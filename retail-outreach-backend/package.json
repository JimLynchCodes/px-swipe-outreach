{
  "name": "retail-outreach-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATA_STORE=memory AUTH_MODE=demo EMAIL_PROVIDER=log SMS_PROVIDER=log tsx watch src/server.ts",
    "dev:live": "tsx watch --env-file=.env.local src/server.ts",
    "dev:supabase": "tsx watch --env-file=.env.supabase.local src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:local": "tsx src/db/migrate.ts --bootstrap-plain-postgres",
    "db:seed": "tsx src/db/seed.ts",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run test/db",
    "db:migrate:prod": "node dist/db/migrate.js",
    "eval": "tsx src/ai/evals/run.ts",
    "sync": "tsx src/sync/cli.ts",
    "sync:all": "tsx src/sync/cli.ts all",
    "sync:ai-usage": "tsx src/sync/cli.ts ai-usage",
    "sync:twilio": "tsx src/sync/cli.ts twilio",
    "sync:email": "tsx src/sync/cli.ts email",
    "sync:quickvee:rewards": "tsx src/sync/cli.ts quickvee-rewards",
    "sync:quickvee:orders": "tsx src/sync/cli.ts quickvee-orders",
    "scrape:quickvee:orders": "tsx src/orders/scrapeCli.ts",
    "quickvee:mock": "tsx test/fixtures/quickveePortal.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.2.1",
    "bullmq": "^5.34.3",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jose": "^5.10.0",
    "nodemailer": "^10.3.1",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "playwright-core": "^1.65.0",
    "twilio": "^6.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "smtp-server": "^3.21.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
