NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Comma-separated browser origins allowed by CORS ("*" = any, dev only).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# memory = seeded demo data, no infrastructure needed. postgres = use DATABASE_URL (run `npm run db:migrate`).
DATA_STORE=memory
DATABASE_URL=postgres://outreach:outreach@localhost:5432/outreach

# inline = send during the request. queue = BullMQ via Redis + `npm run worker` (requires DATA_STORE=postgres).
DELIVERY_MODE=inline
REDIS_URL=redis://localhost:6379

# Leave blank to use the built-in rules-based suggestions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Message providers. Only "console" (log, don't send) is implemented today.
SMS_PROVIDER=console
EMAIL_PROVIDER=console
BUSINESS_NAME=our store

# DEMO auth: every request acts as this user/tenant. Refused when NODE_ENV=production.
DEV_USER_ID=demo-user
DEV_TENANT_ID=demo-retailer
