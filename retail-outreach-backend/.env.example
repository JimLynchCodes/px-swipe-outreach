# ─── Runtime ───────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true when behind a load balancer/reverse proxy (uses X-Forwarded-For for client IPs / rate limits).
TRUST_PROXY=false
# Comma-separated browser origins allowed by CORS. Production: https:// origins only, no "*".
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=300
SEND_RATE_LIMIT_PER_MINUTE=30

# ─── Auth ──────────────────────────────────────────────────────────────
# demo     = no login; every request is the demo user (refused when NODE_ENV=production)
# supabase = verify Supabase Auth access tokens
AUTH_MODE=demo
# https://<project-ref>.supabase.co  (Project Settings → Data API, or the Connect dialog)
SUPABASE_URL=
# Only for projects still on the legacy HS256 JWT secret (Project Settings → API → JWT Settings).
# Leave empty to verify against the project's JWKS (asymmetric signing keys) - recommended.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Exposes POST /api/dev/reset (defaults to on outside production; always off in production).
ENABLE_DEMO_RESET=

# ─── Data ──────────────────────────────────────────────────────────────
# memory   = seeded demo data, no infrastructure needed
# postgres = DATABASE_URL (Supabase or local). Apply migrations first: see docs/SUPABASE_SETUP.md
DATA_STORE=memory
# Supabase: Connect (top bar) → Connection string (Supavisor, transaction mode :6543, or session :5432).
# The backend connects with the privileged `postgres` user and drops to `authenticated` per request (RLS applies).
# ⚠ Backend secret. Never put this (or SUPABASE_SECRET_KEY) in the frontend.
DATABASE_URL=
DATABASE_POOL_MAX=10
# Optional. PEM text or a file path to Supabase's CA cert, for verified TLS (Project Settings → Database → SSL Configuration).
DATABASE_CA_CERT=

# ─── Delivery ──────────────────────────────────────────────────────────
# inline = send during the request. queue = BullMQ via Redis + `npm run worker` (requires DATA_STORE=postgres).
DELIVERY_MODE=inline
REDIS_URL=redis://localhost:6379
# Message providers. Only "console" (log, don't send) is implemented today.
# ── Delivery (docs/LOCAL_DELIVERY_TESTING.md). `npm run dev` forces log; `npm run dev:live` reads .env.local. ──
# Production refuses log.
# EMAIL_PROVIDER: log (print only) | smtp (real email via Nodemailer: Gmail app password, any SMTP host, or optional Mailpit)
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); defaults from the port
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMS_PROVIDER: log (print only) | twilio (real SMS via the official twilio SDK)
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN (below) also verifies X-Twilio-Signature on inbound webhooks, against PUBLIC_API_URL.
# Sender: an E.164 number, or a Messaging Service SID (takes precedence).
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Twilio spend (Cost metrics). Per-segment USD estimate shown until Twilio reports the actual price:
# $0.0083 Twilio fee + ~$0.0042 carrier fee (US long code, Oct 2026). Check https://www.twilio.com/en-us/sms/pricing/us
TWILIO_SMS_PRICE_ESTIMATE=0.0125
# Optional flat monthly phone-number fee added to each month with texts (long code ≈ 1.15). 0 = off.
TWILIO_NUMBER_MONTHLY_FEE=0
# StatusCallback on each SMS (only when PUBLIC_API_URL is public), and minutes between price reconcile runs (0 = off).
TWILIO_STATUS_CALLBACKS=true
TWILIO_RECONCILE_MINUTES=10
# Fallback sender name; each org's business_name takes precedence.
BUSINESS_NAME=our store

# ─── AI ────────────────────────────────────────────────────────────────
# Leave both keys blank to use the built-in rules-based suggestions.
# OpenRouter (default provider when its key is set): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional direct OpenAI. With both keys set, the non-primary one is the fallback.
OPENAI_API_KEY=
# openrouter | openai. Defaults to openrouter when OPENROUTER_API_KEY is set. The matching key is required at startup.
AI_PROVIDER=
# Fallback model only; each org picks its model in the app (allowlist: src/ai/models.ts).
OPENAI_MODEL=openai/gpt-4o-mini
# Sent to OpenRouter as X-Title (HTTP-Referer is APP_URL). Optional.
OPENROUTER_APP_NAME=PX Swipe Outreach

SHUTDOWN_TIMEOUT_MS=10000

# Team invitations. APP_URL is the frontend origin used in invite links.
APP_URL=http://localhost:5173
# console = log the accept link (dev). supabase = send via Supabase Auth (required in production).
INVITE_MAILER=console
# Approved owners: these emails (comma-separated, case-insensitive) become an owner of the default org on their first
# sign-in, if their email is confirmed and they aren't on any team yet. The default org is the oldest one, or a new
# one named BOOTSTRAP_ORG_NAME if none exists. Alternative: `npm run bootstrap:owner -- you@example.com`.
BOOTSTRAP_OWNER_EMAILS=mrdotjim@gmail.com
BOOTSTRAP_ORG_NAME=My Store
# Backend-only secret; only needed for INVITE_MAILER=supabase. NEVER put this in the frontend.
# Project Settings → API Keys → Secret key (sb_secret_…).
SUPABASE_SECRET_KEY=
# Legacy alias: SUPABASE_SERVICE_ROLE_KEY (old service_role JWT) is still read if SUPABASE_SECRET_KEY is empty.
# SUPABASE_SERVICE_ROLE_KEY=
INVITE_TTL_HOURS=168
INVITE_RATE_LIMIT_PER_HOUR=30
INVITE_RESEND_COOLDOWN_SECONDS=60

# ─── Opt-outs & replies (docs/OUTREACH_FEATURES.md) ───────────────────
# Public origin of this API (unsubscribe links + Twilio signature URL). https in production.
PUBLIC_API_URL=http://localhost:3000
# ≥32 random chars; signs email unsubscribe links. REQUIRED in production. e.g. `openssl rand -base64 48`
UNSUBSCRIBE_SIGNING_SECRET=
# Twilio auth token: verifies X-Twilio-Signature on POST /webhooks/twilio/sms/<orgId>.
TWILIO_AUTH_TOKEN=
# Inbound email (SendGrid Inbound Parse): MX for this domain → provider; webhook
# ${PUBLIC_API_URL}/webhooks/email/inbound?key=${INBOUND_EMAIL_SECRET}
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
# Allow ONE re-permission text ("reply START") to a number that replied STOP. Off by default: get a compliance review first.
ALLOW_SMS_REOPTIN_REQUEST=false

# ─── Data sync (docs/DATA_SYNC.md). Backend-only secrets; the UI only shows which names are missing. ───
# Runs the DB-backed scheduler in this process (safe with several instances).
SYNC_SCHEDULER=true
SYNC_SCHEDULER_INTERVAL_SECONDS=60
# ai-usage: OpenAI admin key (Usage + Costs APIs) and/or OpenRouter (uses OPENROUTER_API_KEY; /activity needs a provisioning key).
OPENAI_ADMIN_KEY=
OPENROUTER_PROVISIONING_KEY=
# email: ledger (default) or sendgrid (Email Activity API add-on).
EMAIL_EVENTS_PROVIDER=ledger
SENDGRID_API_KEY=
# Quickvee: the merchant's OWN portal login only. Never logged. Session + raw snapshots go to QUICKVEE_STATE_DIR (gitignored).
# The three fields on the Quickvee login page. QUICKVEE_EMAIL is still read as a deprecated alias for QUICKVEE_USERNAME.
QUICKVEE_STORE_NAME=
QUICKVEE_USERNAME=
QUICKVEE_PASSWORD=
QUICKVEE_BASE_URL=https://quickvee.com  # login at /merchants/login, orders at /merchants/order-new
QUICKVEE_STATE_DIR=.quickvee
# false = open a visible browser (first run: calibrate selectors / complete MFA).
QUICKVEE_HEADLESS=true
QUICKVEE_SAVE_RAW=true
QUICKVEE_MIN_DELAY_MS=1500
QUICKVEE_CHUNK_DAYS=7
# Scheduled orders sync: stop after N orders per run (0/empty = all). The CLI uses --limit instead.
QUICKVEE_ORDER_LIMIT=
# Orders Management tab(s) to crawl: in-store | online | both.
QUICKVEE_ORDER_CHANNEL=in-store
# Stop scrolling the order list when nothing new loads for this many seconds.
QUICKVEE_STALL_SECONDS=30
# Auto-detected (/usr/bin/chromium*, google-chrome). Docker image: /usr/bin/chromium-browser.
QUICKVEE_CHROMIUM_PATH=
