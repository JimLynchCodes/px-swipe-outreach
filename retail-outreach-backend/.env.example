# ─── Runtime ───────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true when behind a load balancer/reverse proxy (uses X-Forwarded-For for client IPs / rate limits).
TRUST_PROXY=false
# Comma-separated browser origins allowed by CORS. Production: https:// origins only, no "*".
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=300
SEND_RATE_LIMIT_PER_MINUTE=30

# ─── Auth ──────────────────────────────────────────────────────────────
# demo     = no login; every request is the demo user (refused when NODE_ENV=production)
# supabase = verify Supabase Auth access tokens
AUTH_MODE=demo
# https://<project-ref>.supabase.co  (Project Settings → API → Project URL)
SUPABASE_URL=
# Only for projects still on the legacy HS256 JWT secret (Project Settings → API → JWT Settings).
# Leave empty to verify against the project's JWKS (asymmetric signing keys) - recommended.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Exposes POST /api/dev/reset (defaults to on outside production; always off in production).
ENABLE_DEMO_RESET=

# ─── Data ──────────────────────────────────────────────────────────────
# memory   = seeded demo data, no infrastructure needed
# postgres = DATABASE_URL (Supabase or local). Apply migrations first: see docs/SUPABASE_SETUP.md
DATA_STORE=memory
# Supabase: Project Settings → Database → Connection string (Supavisor, transaction mode :6543, or session :5432).
# The backend connects with the privileged `postgres` user and drops to `authenticated` per request (RLS applies).
# ⚠ Backend secret. Never put this (or the service_role key) in the frontend.
DATABASE_URL=
DATABASE_POOL_MAX=10
# PEM text or a file path to Supabase's CA cert, for verified TLS (Project Settings → Database → SSL).
DATABASE_CA_CERT=

# ─── Delivery ──────────────────────────────────────────────────────────
# inline = send during the request. queue = BullMQ via Redis + `npm run worker` (requires DATA_STORE=postgres).
DELIVERY_MODE=inline
REDIS_URL=redis://localhost:6379
# Message providers. Only "console" (log, don't send) is implemented today.
SMS_PROVIDER=console
EMAIL_PROVIDER=console
# Fallback sender name; each org's business_name takes precedence.
BUSINESS_NAME=our store

# ─── AI ────────────────────────────────────────────────────────────────
# Leave blank to use the built-in rules-based suggestions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

SHUTDOWN_TIMEOUT_MS=10000
