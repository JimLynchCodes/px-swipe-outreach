# Copy to .env.supabase.local (git-ignored) for `npm run dev:supabase`. Backend secrets: never put these in the frontend.
DATA_STORE=postgres
AUTH_MODE=supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase → Connect (top bar) → Connection string (use the pooler URI, sslmode=require)
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Invitations via Supabase Auth (the secret key stays on the server)
INVITE_MAILER=supabase
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…).
SUPABASE_SECRET_KEY=
# Legacy alias: SUPABASE_SERVICE_ROLE_KEY (old service_role JWT) is still read if SUPABASE_SECRET_KEY is empty.
# SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Delivery: log here; switch to smtp/twilio as in docs/LOCAL_DELIVERY_TESTING.md
EMAIL_PROVIDER=log
SMS_PROVIDER=log
