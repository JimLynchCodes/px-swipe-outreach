# Base URL of the retail-outreach-backend API.
# Leave empty in development: Vite proxies /api and /health to VITE_PROXY_TARGET.
# Set it for a production build served from a different origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Where the dev server proxies /api requests (dev only).
VITE_PROXY_TARGET=http://localhost:3000

# Supabase Auth. PUBLIC values only (URL: Project Settings → Data API):
#   URL + the publishable key. NEVER a secret (sb_secret_…) or service_role key -
#   anything prefixed VITE_ is baked into the public JS bundle. The app refuses to start with one.
VITE_SUPABASE_URL=
# Project Settings → API Keys → Publishable key (sb_publishable_…).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias: VITE_SUPABASE_ANON_KEY (old anon JWT) is still read if VITE_SUPABASE_PUBLISHABLE_KEY is empty.
# VITE_SUPABASE_ANON_KEY=

# Without Supabase config, `npm run dev` runs in demo mode (no login, backend AUTH_MODE=demo).
# Production builds refuse to run without Supabase config unless this is "true".
VITE_DEMO_MODE=
