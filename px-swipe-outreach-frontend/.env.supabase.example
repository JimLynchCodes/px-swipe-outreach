# Copy to .env.supabase.local (git-ignored) for `npm run dev:supabase` (vite --mode supabase).
# Public values only: the publishable key, never a secret (sb_secret_…) or service_role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias: VITE_SUPABASE_ANON_KEY (old anon JWT) is still read if VITE_SUPABASE_PUBLISHABLE_KEY is empty.
# VITE_SUPABASE_ANON_KEY=
